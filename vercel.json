{
  "rewrites": [
    {
      "source": "/js/servicos.js",
      "destination": "https://anamnese.vivamaisbella.online/js/servicos.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/(index.html|paciente.html|sw.js|)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/js/app-vmb.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
